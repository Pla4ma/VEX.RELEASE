{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "24.18.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_ENABLE_EXPO_GO_SHIMS": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "24.18.0",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_ENABLE_EXPO_GO_SHIMS": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.18.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium",
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_ENABLE_SKIP_LOGIN": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_ENABLE_EXPO_GO_SHIMS": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "node": "24.18.0",
      "ios": {
        "resourceClass": "m-large"
      },
      "android": {
        "resourceClass": "large"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_ENABLE_SKIP_LOGIN": "0",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "${EAS_APPLE_ID}",
        "ascAppId": "${EAS_ASC_APP_ID}",
        "appleTeamId": "${EAS_APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "${EAS_GOOGLE_SERVICE_ACCOUNT_KEY_PATH}",
        "track": "production"
      }
    }
  }
}
